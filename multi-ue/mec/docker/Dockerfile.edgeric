FROM python:3.12-slim
WORKDIR /work/multi-ue
COPY multi-ue/requirements.txt requirements.txt
RUN python -m pip install -r requirements.txt
COPY multi-ue/contracts contracts
COPY multi-ue/config config
# Build from the repository root so the muApp and shared contracts are available.
COPY EdgeRIC-v2/muApp_mec /work/EdgeRIC-v2/muApp_mec
ENV PYTHONPATH=/work/multi-ue/contracts/python:/work/EdgeRIC-v2
CMD ["python", "-m", "muApp_mec", "--config", "config/edgeric.shadow.yaml"]
