# =============================================================================
# Config Files
# =============================================================================

SYSTEM_CONFIG="../common/sys_config.yaml"
GNB_CONFIG="../common/gnb.sa.band78.24prbs.conf"

CUDA_MPS_PIPE_DIRECTORY=/tmp/nvidia-mps
CUDA_MPS_LOG_DIRECTORY=/tmp/nvidia-log

# =============================================================================
# Image Tags
# =============================================================================

GNB_IMAGE=oai-gnb-cuda
GNB_TAG=latest
UE_IMAGE=oai-nr-ue-cuda
UE_TAG=latest
AMF_TAG=v2.1.10
SMF_TAG=v2.1.10
UPF_TAG=v2.1.10
TRFGEN_TAG=latest
FLEXRIC_TAG=latest

# =============================================================================
# gNB Extra Options
# =============================================================================

# note that this is platform specific
GNB_THREAD_POOL="--thread-pool ${SRK_THREAD_POOL:-6,7,8,9,10,11}"

#GNB_EXTRA_OPTIONS="--loader.ldpc.shlibversion _cuda"

# --- Tutorials (activate by loading the library) ---
# CUDA LDPC
#GNB_EXTRA_OPTIONS="--loader.ldpc.shlibversion _cuda"

# Demapper
#GNB_EXTRA_OPTIONS="--loader.demapper.shlibversion _orig"
#GNB_EXTRA_OPTIONS="--loader.demapper.shlibversion _capture"
#GNB_EXTRA_OPTIONS="--loader.demapper.shlibversion _trt --MACRLCs.[0].dl_max_mcs 10 --MACRLCs.[0].ul_max_mcs 10"

# Neural Receiver
# works best with 24 PRBs
#GNB_EXTRA_OPTIONS="--loader.receiver.shlibversion _trt --MACRLCs.[0].ul_max_mcs 10"

# Channel Emulation (choose one CIR source: cir_file or cir_zmq)
# Option 1: File-based CIR (loads pre-computed CIR data from folder)
#GNB_EXTRA_OPTIONS="--cir-folder /opt/oai-gnb/plugins/channel_emulation/data/pass_through_cir"
# Option 2: ZMQ-based CIR (receives CIR data via ZMQ at runtime, use with Sionna RT GUI)
#GNB_EXTRA_OPTIONS="--cir-zmq-num-taps 48"

# MPS active thread percentage (only relevant when running the Sionna RT GUI)
#MPS_ACTIVE_THREAD_PCT=30.0

# =============================================================================
# UE Extra Options (soft-UE only)
# =============================================================================

#UE_EXTRA_OPTIONS="-C 3309480000 -r 51 --numerology 1 --ssb 238 --thread-pool ${SRK_UE_THREAD_POOL:-3,4}"

# --- PRB configs (uncomment one to replace UE_EXTRA_OPTIONS above) ---
UE_EXTRA_OPTIONS="-C 3604800000 -r 24 --numerology 1 --ssb 24 --thread-pool ${SRK_UE_THREAD_POOL:-3,4}"
#UE_EXTRA_OPTIONS="-C 3309480000 -r 51 --numerology 1 --ssb 238 --thread-pool ${SRK_UE_THREAD_POOL:-3,4}"
#UE_EXTRA_OPTIONS="-C 3319680000 -r 106 --numerology 1 --ssb 516 --thread-pool ${SRK_UE_THREAD_POOL:-3,4}"

# =============================================================================
# B200/USRP Hardware Configuration
# =============================================================================

USE_B2XX=yes
USRP_SERIAL=34EE309
USRP_SERIAL_UE=35074B8

# =============================================================================
# RF Options
# =============================================================================

GNB_RF_OPTIONS="--RUs.[0].sdr_addrs addr=192.168.20.2,clock_source=gpsdo,time_source=gpsdo"
UE_RF_OPTIONS="--usrp-args addr=192.168.20.2,time_source=gpsdo,clock_source=gpsdo --ue-fo-compensation --band 78 --ue-rxgain 60 --ue-txgain 60" # RX 40
# --ue-txgain 45 --ue-rxgain 60
# ue-txgain is a backoff from the max tx gain (89.75 dB for B210, 60 dB for X410, fixed).
# ue-rxgain is set and then (for B210 only) has an offset (44 dB) and an adjustment (3 dB) subtracted from it.
# Default ue-txgain: 0
# Default ue-rxgain: 110