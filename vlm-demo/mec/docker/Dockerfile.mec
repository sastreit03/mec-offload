ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:25.12-py3
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /tmp/
COPY mec_app/install_system_deps.sh /tmp/install_system_deps.sh
COPY mec_app/requirements.txt /tmp/requirements.txt
COPY mec_app/requirements-vlm.txt /tmp/requirements-vlm.txt

RUN ./install_system_deps.sh

COPY mec_app/app.py \
    mec_app/check_environment.py \
    mec_app/control.py \
    mec_app/dashboard.py \
    mec_app/models.py \
    mec_app/ran_telemetry.py \
    mec_app/receiver.py \
    mec_app/scheduler.py \
    mec_app/vlm.py \
    /opt/mec-vlm/
COPY mec_app/config.yaml /opt/mec-vlm/config.yaml

WORKDIR /opt/mec-vlm/
RUN groupadd --gid 10001 app && \
    useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin app && \
    chown -R app:app /opt/mec-vlm

USER app
EXPOSE 8765

CMD ["/opt/mec-vlm-venv/bin/python", "/opt/mec-vlm/app.py", "--config", "/opt/mec-vlm/config.yaml"]
