# Acknowledgement: Code in this file was generated by Generative AI
# Build with the commands:
#   cd $HOME/mec-offload-ad/EdgeRIC-v2
#   docker build -f docker/Dockerfile.edgeric -t edgeric:latest .
# Start with the following command: 
#   cd $HOME/mec-offload-ad/EdgeRIC-v2/docker
#   docker compose -f compose.edgeric.yaml up -d --build

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/edgeric

# Python 3.11 is used because portions of the existing EdgeRIC code
# still rely on APIs removed in Python 3.12.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        software-properties-common \
        ca-certificates \
        libzmq5 && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-venv && \
    rm -rf /var/lib/apt/lists/*

# Create isolated Python environment.
RUN python3.11 -m venv /opt/edgeric-venv

ENV PATH="/opt/edgeric-venv/bin:${PATH}"

WORKDIR /opt/edgeric

# Copy requirements first so this layer can be cached independently
# of changes to the EdgeRIC source code.
COPY docker/requirements-base.txt /tmp/requirements-base.txt
COPY docker/requirements-muapp.txt /tmp/requirements-muapp.txt

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
        -r /tmp/requirements-base.txt \
        -r /tmp/requirements-muapp.txt

# Copy the EdgeRIC-v2 source tree.
COPY . /opt/edgeric

# Basic build-time sanity check. Do not attempt to contact the gNB here.
RUN python -c \
    "import zmq, google.protobuf, numpy; \
     import edgeric_messenger; \
     print('EdgeRIC environment OK')"

CMD ["python", "send_weight.py"]