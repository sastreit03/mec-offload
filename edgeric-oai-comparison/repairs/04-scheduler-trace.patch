+++ b/executables/edgeric/scheduler_trace.h
@@ -0,0 +1,56 @@
+/* Optional bounded scheduler tracing. No scheduling state is changed by this API. */
+#ifndef EDGERIC_SCHEDULER_TRACE_H
+#define EDGERIC_SCHEDULER_TRACE_H
+#include <stdint.h>
+#include <stdbool.h>
+#include <float.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Stage identifies the operation at which a rejected candidate stopped. */
+enum { RIC_TRACE_CANDIDATE, RIC_TRACE_BEAM, RIC_TRACE_BUDGET, RIC_TRACE_TDA,
+       RIC_TRACE_SPAN, RIC_TRACE_CAP, RIC_TRACE_SIZING, RIC_TRACE_CCE,
+       RIC_TRACE_PUCCH, RIC_TRACE_COMMITTED };
+enum { RIC_TRACE_NO_EXEMPTION, RIC_TRACE_HARQ, RIC_TRACE_TA, RIC_TRACE_SR_INACTIVE };
+typedef struct {
+  uint64_t time_ns, policy_seq, receive_ns;
+  uint32_t ran_index;
+  int kind, active, direction, rnti, frame, slot, target_frame, target_slot;
+  int beam, stage, exemption, retransmission, weight_present;
+  float weight;
+  int reference, free_span, remaining, quota, cap, sizing_cap;
+  int rb_start, prbs, tbs, mcs, bwp_start, start_symbol, symbols;
+  int dl_entries, ul_entries;
+} ric_trace_record;
+/* Call at initialization/final shutdown only, outside scheduler threads. */
+void ric_trace_start(void);
+void ric_trace_stop(void);
+bool ric_trace_enabled(void);
+uint64_t ric_trace_now_ns(void);
+void ric_trace_policy(uint32_t ran_index, uint64_t receive_ns, int dl_entries, int ul_entries);
+void ric_trace_weight(int direction, uint16_t rnti, float weight);
+void ric_trace_clear(void);
+ric_trace_record ric_trace_begin(int direction, int rnti, int frame, int slot,
+                                int target_frame, int target_slot, int retransmission,
+                                int exemption, float weight);
+void ric_trace_finish(ric_trace_record *record);
+/* Counter snapshot is lock-free, including after shutdown. */
+void ric_trace_counters(uint64_t *queued, uint64_t *dropped, uint64_t *io_errors);
+#ifdef __cplusplus
+}
+#endif
+/* GCC/Clang cleanup emits exactly once on normal return/continue from a scope.
+ * Weight lookup is observational and is skipped entirely when tracing is off. */
+#define RIC_TRACE_SCOPE(name, direction, rnti, frame, slot, tf, ts, retx, exemption, weight) \
+  ric_trace_record name __attribute__((cleanup(ric_trace_finish))) = \
+      ric_trace_begin(direction, rnti, frame, slot, tf, ts, retx, exemption, \
+                      ric_trace_enabled() ? (weight) : FLT_MAX)
+/* Beam rejection before entering the retransmission helper. */
+#define RIC_TRACE_RETX_BEAM_FAILURE(when, direction, rnti, frame, slot, tf, ts, weight) do { \
+  if (ric_trace_enabled() && (when)) { \
+    RIC_TRACE_SCOPE(early_trace, direction, rnti, frame, slot, tf, ts, 1, RIC_TRACE_HARQ, weight); \
+    early_trace.stage = RIC_TRACE_BEAM; \
+  } \
+} while (0)
+#define RIC_TRACE_SET(record, field, value) do { if ((record).active) (record).field = (value); } while (0)
+#endif
