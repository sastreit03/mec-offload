+++ b/executables/edgeric/scheduler_trace.cpp
@@ -0,0 +1,212 @@
+#include "scheduler_trace.h"
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+#include <time.h>
+#include <unistd.h>
+#include <pthread.h>
+
+namespace {
+constexpr size_t capacity = 8192;
+std::array<ric_trace_record, capacity> records;
+std::atomic_flag gate = ATOMIC_FLAG_INIT;
+std::atomic<bool> enabled{false}, stopping{false};
+std::atomic<uint64_t> queued{0}, dropped{0}, io_errors{0};
+static_assert(std::atomic<uint64_t>::is_always_lock_free, "trace counters must not lock");
+size_t head = 0, tail = 0, used = 0;
+std::thread writer;
+FILE *output = nullptr;
+/* Like the existing global EdgeRIC maps, policy context is scheduler-owned.
+ * Snapshot changes and getters execute on the same common scheduler thread. */
+std::atomic<uint64_t> next_policy{0};
+thread_local uint64_t policy_seq = 0, receive_ns = 0;
+thread_local uint32_t ran_index = 0;
+
+void enqueue(const ric_trace_record &r)
+{
+  if (!enabled.load(std::memory_order_relaxed)) return;
+  // One attempt only. The scheduler never spins or waits for the writer.
+  if (gate.test_and_set(std::memory_order_acquire)) {
+    dropped.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  if (used == capacity) {
+    dropped.fetch_add(1, std::memory_order_relaxed);
+  } else {
+    records[tail] = r;
+    tail = (tail + 1) % capacity;
+    ++used;
+    queued.fetch_add(1, std::memory_order_relaxed);
+  }
+  gate.clear(std::memory_order_release);
+}
+
+bool dequeue(ric_trace_record &r)
+{
+  if (gate.test_and_set(std::memory_order_acquire)) return false;
+  const bool found = used != 0;
+  if (found) {
+    r = records[head];
+    head = (head + 1) % capacity;
+    --used;
+  }
+  gate.clear(std::memory_order_release);
+  return found;
+}
+
+void write_record(const ric_trace_record &r)
+{
+  if (std::fprintf(output,
+      "%d,%llu,%llu,%llu,%u,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%.9g,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%llu,%llu,%llu\n",
+      r.kind, (unsigned long long)r.time_ns, (unsigned long long)r.policy_seq,
+      (unsigned long long)r.receive_ns, r.ran_index, r.direction, r.rnti,
+      r.frame, r.slot, r.target_frame, r.target_slot, r.beam, r.stage, r.exemption,
+      r.retransmission, r.weight_present, r.weight, r.reference, r.free_span,
+      r.remaining, r.quota, r.cap, r.sizing_cap, r.rb_start, r.prbs, r.tbs, r.mcs,
+      r.bwp_start, r.start_symbol, r.symbols, r.dl_entries, r.ul_entries,
+      (unsigned long long)queued.load(std::memory_order_relaxed),
+      (unsigned long long)dropped.load(std::memory_order_relaxed),
+      (unsigned long long)io_errors.load(std::memory_order_relaxed)) < 0)
+    io_errors.fetch_add(1, std::memory_order_relaxed);
+}
+
+void run_writer()
+{
+  // Never inherit a realtime scheduling policy from the creating thread.
+  sched_param param{};
+  if (pthread_setschedparam(pthread_self(), SCHED_OTHER, &param) != 0) {
+    io_errors.fetch_add(1, std::memory_order_relaxed);
+    enabled.store(false, std::memory_order_relaxed);
+    return;
+  }
+  auto last = std::chrono::steady_clock::now();
+  while (!stopping.load(std::memory_order_acquire)) {
+    ric_trace_record r;
+    // Bound a batch so counter/flush records cannot starve under sustained load.
+    for (size_t n = 0; n < capacity && dequeue(r); ++n) write_record(r);
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last >= std::chrono::seconds(1)) {
+      ric_trace_record status{};
+      status.kind = 4;
+      status.time_ns = ric_trace_now_ns();
+      write_record(status);
+      if (std::fflush(output) != 0) io_errors.fetch_add(1, std::memory_order_relaxed);
+      last = now;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  // Final shutdown happens after the scheduler has stopped producing records.
+  ric_trace_record r;
+  while (dequeue(r)) write_record(r);
+  r = {};
+  r.kind = 4;
+  r.time_ns = ric_trace_now_ns();
+  write_record(r);
+  if (std::fflush(output) != 0) io_errors.fetch_add(1, std::memory_order_relaxed);
+}
+}
+
+extern "C" bool ric_trace_enabled(void) { return enabled.load(std::memory_order_relaxed); }
+extern "C" uint64_t ric_trace_now_ns(void)
+{
+  timespec ts{};
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return uint64_t(ts.tv_sec) * 1000000000ULL + ts.tv_nsec;
+}
+extern "C" void ric_trace_start(void)
+{
+  const char *path = std::getenv("OAI_SCHED_TRACE_FILE");
+  if (!path || !*path || writer.joinable()) return;
+  output = std::fopen(path, "a");
+  if (!output) { io_errors.fetch_add(1, std::memory_order_relaxed); return; }
+  records.fill({}); // Fault in queue pages during initialization, not on a scheduler grant.
+  std::setvbuf(output, nullptr, _IOFBF, 256 * 1024);
+  timespec wall{};
+  clock_gettime(CLOCK_REALTIME, &wall);
+  std::fprintf(output, "# OAI scheduler trace v1; pid=%ld; monotonic_ns=%llu; realtime_ns=%llu\n",
+               long(getpid()), (unsigned long long)ric_trace_now_ns(),
+               (unsigned long long)(uint64_t(wall.tv_sec) * 1000000000ULL + wall.tv_nsec));
+  std::fprintf(output, "kind,time_ns,policy_seq,receive_ns,ran_index,direction,rnti,frame,slot,target_frame,target_slot,beam,stage,exemption,retransmission,weight_present,weight,reference,free_span,remaining,quota,cap,sizing_cap,rb_start,prbs,tbs,mcs,bwp_start,start_symbol,symbols,dl_entries,ul_entries,queued,dropped,io_errors\n");
+  stopping.store(false, std::memory_order_relaxed);
+  try {
+    enabled.store(true, std::memory_order_release);
+    writer = std::thread(run_writer);
+  } catch (...) {
+    enabled.store(false, std::memory_order_release);
+    io_errors.fetch_add(1, std::memory_order_relaxed);
+    std::fclose(output);
+    output = nullptr;
+  }
+}
+extern "C" void ric_trace_stop(void)
+{
+  enabled.store(false, std::memory_order_release);
+  stopping.store(true, std::memory_order_release);
+  if (writer.joinable()) writer.join();
+  if (output) {
+    if (std::fclose(output) != 0) io_errors.fetch_add(1, std::memory_order_relaxed);
+    output = nullptr;
+  }
+}
+extern "C" ric_trace_record ric_trace_begin(int direction, int rnti, int frame, int slot,
+    int tf, int ts, int retx, int exemption, float weight)
+{
+  ric_trace_record r{};
+  if (!ric_trace_enabled()) return r;
+  r.active = 1;
+  r.kind = 3;
+  r.time_ns = ric_trace_now_ns();
+  r.policy_seq = policy_seq;
+  r.receive_ns = receive_ns;
+  r.ran_index = ran_index;
+  r.direction = direction; r.rnti = rnti; r.frame = frame; r.slot = slot;
+  r.target_frame = tf; r.target_slot = ts;
+  r.retransmission = retx; r.exemption = exemption;
+  r.weight_present = weight != FLT_MAX;
+  r.weight = r.weight_present ? weight : -1;
+  r.beam = r.reference = r.free_span = r.remaining = r.quota = r.cap = r.sizing_cap = -1;
+  r.rb_start = r.mcs = r.bwp_start = r.start_symbol = r.symbols = -1;
+  return r;
+}
+extern "C" void ric_trace_finish(ric_trace_record *r)
+{
+  if (!r->active) return;
+  if (r->exemption == RIC_TRACE_NO_EXEMPTION && r->weight_present && r->reference >= 0
+      && std::isfinite(r->weight) && r->weight >= 0 && r->weight <= 1)
+    r->quota = int(r->weight * r->reference);
+  enqueue(*r);
+}
+extern "C" void ric_trace_policy(uint32_t index, uint64_t received, int dl, int ul)
+{
+  if (!ric_trace_enabled()) return;
+  policy_seq = next_policy.fetch_add(1, std::memory_order_relaxed) + 1; receive_ns = received; ran_index = index;
+  auto r = ric_trace_begin(-1, 0, -1, -1, -1, -1, 0, 0, FLT_MAX);
+  r.kind = 1; r.dl_entries = dl; r.ul_entries = ul;
+  enqueue(r);
+}
+extern "C" void ric_trace_weight(int direction, uint16_t rnti, float weight)
+{
+  auto r = ric_trace_begin(direction, rnti, -1, -1, -1, -1, 0, 0, weight);
+  if (!r.active) return;
+  r.kind = 2;
+  enqueue(r);
+}
+extern "C" void ric_trace_clear(void)
+{
+  // Zero identifies the no-message-cleared snapshot, not the last accepted policy.
+  policy_seq = receive_ns = 0; ran_index = 0;
+}
+extern "C" void ric_trace_counters(uint64_t *q, uint64_t *d, uint64_t *e)
+{
+  *q = queued.load(std::memory_order_relaxed);
+  *d = dropped.load(std::memory_order_relaxed);
+  *e = io_errors.load(std::memory_order_relaxed);
+}
+
+namespace {
+struct TraceShutdown { ~TraceShutdown() { ric_trace_stop(); } } trace_shutdown;
+}
