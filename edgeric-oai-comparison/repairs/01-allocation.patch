+/* Bounded scheduler allocation helpers. All starts passed here are BWP-relative. */
+#ifndef NR_SCHEDULER_ALLOCATION_H
+#define NR_SCHEDULER_ALLOCATION_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <float.h>
+#include <math.h>
+
+static inline int nr_weight_cap(float weight, int reference, int physical)
+{
+  if (physical <= 0)
+    return 0;
+  if (weight == FLT_MAX)
+    return physical;
+  if (!isfinite(weight) || weight < 0 || weight > 1 || reference <= 0)
+    return 0;
+  const int quota = (int)(weight * reference);
+  return quota < physical ? quota : physical;
+}
+
+static inline int nr_free_span_start(const uint16_t *map, int bwp_start, int bwp_size, int count, uint16_t symbols)
+{
+  if (count <= 0 || count > bwp_size)
+    return -1;
+  int run = 0;
+  for (int rb = 0; rb < bwp_size; rb++) {
+    run = (map[bwp_start + rb] & symbols) ? 0 : run + 1;
+    if (run == count)
+      return rb + 1 - count;
+  }
+  return -1;
+}
+
+/* Cheap production checks; full occupancy scan enabled explicitly for debug/tests.
+ * Return false rather than aborting the gNB on an invalid candidate. */
+static inline bool nr_grant_valid(const uint16_t *map, int bwp_start, int bwp_size,
+                                  int start, int count, int budget, uint32_t tbs, uint16_t symbols)
+{
+  if (bwp_start < 0 || start < 0 || count <= 0 || tbs == 0 || count > budget || start > bwp_size - count)
+    return false;
+#ifdef NR_SCHEDULER_ALLOCATION_DEBUG
+  for (int rb = 0; rb < count; rb++)
+    if (map[bwp_start + start + rb] & symbols)
+      return false;
+#else
+  (void)map;
+  (void)symbols;
+#endif
+  return true;
+}
+
+static inline void nr_mark_grant(uint16_t *map, int bwp_start, int start, int count, uint16_t symbols)
+{
+  for (int rb = 0; rb < count; rb++)
+    map[bwp_start + start + rb] |= symbols;
+}
+#endif
