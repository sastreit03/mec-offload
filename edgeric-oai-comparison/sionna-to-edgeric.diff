-    LOG_E(NR_PHY,
-          "Rate Matching, Code segments %d...%d/%d (coded bits (G) %u, E %d, Kr %d, Filler bits %d, Filler offset %d mod_order %d, "
-          "nb_rb %d)...\n",
-          macro_segment,
-	  macro_segment_end,
-          impp->n_segments,
