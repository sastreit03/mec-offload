-
-  while (rte_atomic16_read(&tp->op_params->sync) == SYNC_WAIT)
-    rte_pause();
-
-  int ret = rte_bbdev_enc_op_alloc_bulk(tp->bbdev_op_pool, ops_enq, num_segments);
