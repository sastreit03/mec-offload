-  }
-
-  if (ParamList->numelt > 0 && params != NULL) {
-    ParamList->paramarray = static_cast<paramdef_t **>(config_allocate_new(cfg, ParamList->numelt * sizeof(paramdef_t *), true));
-
-    for (int i = 0; i < ParamList->numelt; i++) {
