+int binomial(int n, int k) {
+  int c = 1, i;
+
+  if (k > n-k) 
+    k = n-k;
+
+  for (i = 1; i <= k; i++, n--) {
+    if (c/i > UINT_MAX/n) // return 0 on overflow
+      return 0;
+
+    c = c / i * n + c % i * n / i;
+  }
+  return c;
+}
 
