-    // SIB19 should be received before T430 expires
-    // SIB19 validity timer should expire before T430 expiry such that new SIB19 is read
-    if (sib19_timer_ms > 0) {
-      nr_timer_setup(&SI_info->SInfo_r17.sib19_timer, sib19_timer_ms, 10);
