-    .gNB_cu_cp_ue_id = ue_id,
-    .secInfo.cipheringAlgorithm = 0, /* no ciphering/NEA0 */
-    .secInfo.integrityProtectionAlgorithm = 0, /* no integrity/NIA0 */
-    /* encryptionKey not needed */
