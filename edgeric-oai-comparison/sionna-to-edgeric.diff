-
-  // T3448 Timer (Optional)
-  if (msg->t3448) {
-    ENCODE_NAS_IE(ba, encode_gprs_timer_ie(&ba, IEI_T3448_VALUE, msg->t3448), encoded);
-  }
-
-  // EAP message (Optional)
-  if (msg->eap_msg) {
-    ENCODE_NAS_IE(ba, encode_eap_msg_ie(&ba, msg->eap_msg), encoded);
