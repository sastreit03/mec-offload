+int16_t saturating_sub(int16_t a, int16_t b)
+{
+  int32_t result = (int32_t)a - (int32_t)b;
+
+  if (result < INT16_MIN) {
+    return INT16_MIN;
+  } else if (result > INT16_MAX) {
+    return INT16_MAX;
+  } else {
+    return (int16_t)result;
+  }
+}
