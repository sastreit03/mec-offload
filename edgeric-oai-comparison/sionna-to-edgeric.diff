-/* 3GPP TS 24.008 10.5.7.3 GPRS Timer */
-static int process_gprs_timer(gprs_timer_t *timer)
-{
-  if (!timer)
-    return -1;
-
-  int factor = 0;
-  switch (timer->unit) {
-    case TWO_SECONDS:
-      factor = 2;
-      break;
-    case ONE_MINUTE:
-      factor = 60;
-      break;
-    case DECIHOURS:
-      factor = 360; // 6 minutes
-      break;
-    case DEACTIVATED:
-      return -1;
-    default:
-      factor = 60; // default is 60 seconds
-      break;
-  }
-
-  return timer->value * factor;
-}
