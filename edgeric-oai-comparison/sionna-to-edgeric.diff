-        && push32(value->num_TLV, ppWritePackedMsg, end)))
-    return 0;
-
-  for (int i = 0; i < value->num_TLV; ++i) {
-    if (!push16(value->TLVs[i].tag, ppWritePackedMsg, end))
-      return 0;
