+//----------------------------------------------------------------------------------------------
+// 64-QAM
+//----------------------------------------------------------------------------------------------
+
+void nr_ulsch_64qam_llr(int32_t *rxdataF_comp,
+                        int32_t *ul_ch_mag,
+                        int32_t *ul_ch_magb,
+                        int16_t *ulsch_llr,
+                        uint32_t nb_re,
+                        uint8_t symbol)
+{
+  simde__m256i *rxF = (simde__m256i *)rxdataF_comp;
+
+  simde__m256i *ch_maga = (simde__m256i *)ul_ch_mag;
+  simde__m256i *ch_magb = (simde__m256i *)ul_ch_magb;
+
