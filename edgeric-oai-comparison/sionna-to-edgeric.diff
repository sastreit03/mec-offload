-ssize_t read_to_buffer(char* fname, int fd, char* buffer, uint64_t size, uint64_t base)
-{
-  ssize_t rc;
-  uint64_t count = 0;
-  char* buf = buffer;
-  off_t offset = base;
-
-  while (count < size) {
-    uint64_t bytes = size - count;
-
-    if (bytes > RW_MAX_SIZE)
-      bytes = RW_MAX_SIZE;
-
-    if (offset) {
-      rc = lseek(fd, offset, SEEK_SET);
-      if (rc != offset) {
-        fprintf(stderr, "%s, seek off 0x%lx != 0x%lx.\n", fname, rc, offset);
-        perror("seek file");
-        return -EIO;
-      }
-    }
-    /* read data from file into memory buffer */
-    rc = read(fd, buf, bytes);
-
-    if (rc != bytes) {
-      fprintf(stderr, "%s, R off 0x%lx, 0x%lx != 0x%lx.\n", fname, count, rc, bytes);
-      perror("read file");
-      return -EIO;
-    }
-
-    count += bytes;
-    buf += bytes;
-    offset += bytes;
-  }
-
-  if (count != size) {
-    fprintf(stderr, "%s, R failed 0x%lx != 0x%lx.\n", fname, count, size);
-    return -EIO;
-  }
-  return count;
-}
-
-ssize_t write_from_buffer(char* fname, int fd, char* buffer, uint64_t size, uint64_t base)
-{
-  ssize_t rc;
-  uint64_t count = 0;
-  char* buf = buffer;
-  off_t offset = base;
-
-  while (count < size) {
-    uint64_t bytes = size - count;
-
-    if (bytes > RW_MAX_SIZE)
-      bytes = RW_MAX_SIZE;
-
-    if (offset) {
-      rc = lseek(fd, offset, SEEK_SET);
-      if (rc != offset) {
-        fprintf(stderr, "%s, seek off 0x%lx != 0x%lx.\n", fname, rc, offset);
-        perror("seek file");
-        return -EIO;
-      }
-    }
-
-    /* write data to file from memory buffer */
-    rc = write(fd, buf, bytes);
-    if (rc != bytes) {
-      fprintf(stderr, "%s, W off 0x%lx, 0x%lx != 0x%lx.\n", fname, offset, rc, bytes);
-      perror("write file");
-      return -EIO;
-    }
-
-    count += bytes;
-    buf += bytes;
-    offset += bytes;
-  }
-
-  if (count != size) {
-    fprintf(stderr, "%s, R failed 0x%lx != 0x%lx.\n", fname, count, size);
-    return -EIO;
-  }
-  return count;
-}
