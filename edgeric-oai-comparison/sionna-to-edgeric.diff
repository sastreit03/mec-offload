+                    ppWritePackedMsg,
+                    end))
+      return 0;
+  }
+
+  if ((value->pduBitmap >> 3) & 0x01) { //CSI-2
+    if (!push8(value->csi_part2.csi_part2_crc, ppWritePackedMsg, end))
