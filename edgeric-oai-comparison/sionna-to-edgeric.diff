+// DPDK BBDEV copy
+static inline void
+mbuf_reset(struct rte_mbuf *m)
+{
+  m->pkt_len = 0;
+
+  do {
+    m->data_len = 0;
+    m = m->next;
+  } while (m != NULL);
+}
