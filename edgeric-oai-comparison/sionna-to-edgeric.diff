-        DL_UP_Param->cell_Group_ID = k->cell_group_id;
-      }
-    }
-    // QoS Flows to setup (O)
-    for (const qos_flow_to_setup_t *k = j->qosFlows; k < j->qosFlows + j->numQosFlow2Setup; k++) {
