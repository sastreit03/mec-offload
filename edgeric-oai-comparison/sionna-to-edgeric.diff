-
-  // PDU Session Modified List
-  for (int i = 0; i < a->numPDUSessionsMod; i++) {
-    const pdu_session_modif_t *pduA = &a->pduSessionMod[i];
-    const pdu_session_modif_t *pduB = &b->pduSessionMod[i];
-
-    _E1_EQ_CHECK_LONG(pduA->id, pduB->id);
