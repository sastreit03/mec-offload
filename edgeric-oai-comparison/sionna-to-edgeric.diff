-    ru_session->ru_notif.rx_carrier_state = false;
-    ru_session->ru_notif.tx_carrier_state = false;
-    ru_session->ru_notif.config_change = false;
-  }
-
-  free(operational_ds);
-  free(watchdog_answer);
-
-  return true;
-}
