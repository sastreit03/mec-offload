+static int s_send(void *socket, char *string)
+{
+    // initialize zmq_msg_t object
+    zmq_msg_t msg;
+    zmq_msg_init_size(&msg, strlen(string));
+    memcpy(zmq_msg_data(&msg), string, strlen(string));
+ 
+    // send
+    int rc = zmq_msg_send(&msg, socket, 0);
+ 
+    // close zmq_msg_t
+    zmq_msg_close(&msg);
+ 
+    return rc;
+}
