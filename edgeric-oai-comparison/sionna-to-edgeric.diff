-// Get Time Stamp in microseconds in YYYYMMDDHHMMSSmmmuuu format
-char *get_time_stamp_usec(char time_stamp_str[])
-{
-  // initialization to measure time stamp --This part should be moved to inilization part
-  time_t my_time;
