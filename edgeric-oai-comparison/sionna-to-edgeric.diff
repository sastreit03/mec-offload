+-int look_up_tlv(int tag_id)
+-{
+-	int i;
+-	int num_tags = sizeof(tags) / sizeof(tlv_t);
+-
+-	for (i = 0; i < num_tags; i++)
+-	{
+-		if (tag_id == tags[i].tag_id)
+-			return i;
+-	}
+-	return -1;
+-}
