-static BIT_STRING_t bit_string_clone(const BIT_STRING_t *orig)
-{
-  BIT_STRING_t bs = {.size = orig->size, .bits_unused = orig->bits_unused};
-  bs.buf = malloc_or_fail(bs.size * sizeof(*bs.buf));
-  memcpy(bs.buf, orig->buf, bs.size);
-  return bs;
-}
