-  if (msg_p != NULL) {
-    nr_ue_nas_t *nas = get_ue_nas_info(msg_p->ittiMsgHeader.destinationInstance);
-
-    switch (ITTI_MSG_ID(msg_p)) {
-      case INITIALIZE_MESSAGE:
-
-        break;
-
-      case TERMINATE_MESSAGE:
