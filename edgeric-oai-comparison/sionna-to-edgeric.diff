+    break;
+  case 8:
+    e0=e;
+    e1=e0+EQm;
+    e2=e1+EQm;
+    e3=e2+EQm;
+    e4=e3+EQm;
+    e5=e4+EQm;
+    e6=e5+EQm;
+    e7=e6+EQm;
+    for (int j = 0, j2 = 0; j< EQm; j++,j2+=8){
+      fp=&f[j2];
+      fp[0] = e0[j];
+      fp[1] = e1[j];
+      fp[2] = e2[j];
+      fp[3] = e3[j];
+      fp[4] = e4[j];
+      fp[5] = e5[j];
+      fp[6] = e6[j];
+      fp[7] = e7[j];
