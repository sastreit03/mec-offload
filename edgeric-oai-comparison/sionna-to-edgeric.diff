-static char *get_param_str(char *name)
-{
-  int idx = config_paramidx_fromname(config_parameters, sizeofArray(config_parameters), name);
-
-  char *param;
-  if (config_parameters[idx].strptr != NULL)
-    param = *config_parameters[idx].strptr;
-  else
-    param = NULL;
