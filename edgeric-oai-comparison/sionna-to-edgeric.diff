+
+  int i;
+  c16_t alpha;
+
+  memset(output,0,256*2);
+
+  input[0] = 100;
+  input[1] = 200;
+  input[2] = 100;
+  input[3] = 200;
+  input[4] = 1234;
+  input[5] = -1234;
+  input[6] = 1234;
+  input[7] = -1234;
+  input[8] = 100;
+  input[9] = 200;
+  input[10] = 100;
+  input[11] = 200;
+  input[12] = 1000;
+  input[13] = 2000;
+  input[14] = 1000;
+  input[15] = 2000;
+
+  alpha.r = 10;
+  alpha.i = -10;
+
+  add_cpx_vector(input,(short*) &alpha,input,8);
+
+  for (i=0; i<16; i+=2)
+    printf("output[%d] = %d + %d i\n",i,input[i],input[i+1]);
+
+}
+
+#endif //MAIN
