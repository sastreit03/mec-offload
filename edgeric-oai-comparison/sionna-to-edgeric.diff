+
+#include "LAYER2/NR_MAC_gNB/mac_proto.h"
+#include "executables/softmodem-common.h"
+#include "common/utils/nr/nr_common.h"
+#include "utils.h"
+#include <openair2/UTIL/OPT/opt.h>
+#include "LAYER2/NR_MAC_COMMON/nr_mac_extern.h"
