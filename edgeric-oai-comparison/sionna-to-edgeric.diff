-  AssertFatal(ret == 0, "pthread_create() failed: errno %d, %s\n", errno, strerror(errno));
-
-  uint64_t timestamp = 0;
-  int iq_contents = 0;
-  while (timestamp < num_samples_per_update * num_updates) {
