-/**
- * @brief E1AP Bearer Modification Response equality check
- */
-bool eq_bearer_context_mod_response(const e1ap_bearer_modif_resp_t *a, const e1ap_bearer_modif_resp_t *b)
-{
-  if (!a || !b) return false; // Null-check both inputs
