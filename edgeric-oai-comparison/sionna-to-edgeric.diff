-#define _F1_EQ_CHECK_GENERIC(condition, fmt, ...)                                                                       \
-  do {                                                                                                                  \
-    if (!(condition)) {                                                                                                 \
-      PRINT_ERROR("Equality condition '%s' failed: " fmt " != " fmt "\n", #condition, ##__VA_ARGS__); \
-      return false;                                                                                                     \
-    }                                                                                                                   \
-  } while (0)
