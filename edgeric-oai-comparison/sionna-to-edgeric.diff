-/**
- * @brief Capture IPv4 PDU Session Address
- */
-static int capture_ipv4_addr(const uint8_t *addr, char *ip, size_t len)
-{
-  return snprintf(ip, len, "%d.%d.%d.%d", addr[0], addr[1], addr[2], addr[3]);
