+    //print_ints("unpack lo :",&tmpy0[i]);
+    tmpy1  = simde_mm_unpackhi_epi32(tmp_re,tmp_im); //Q(28-shift)
+    //print_ints("mrc rho0:",&tmpy1[i]);
+    *y_128 = simde_mm_packs_epi32(tmpy0,tmpy1); //must be Q15
