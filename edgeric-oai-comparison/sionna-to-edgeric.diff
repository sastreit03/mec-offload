-{
-  int timeout = CLI_RPC_REPLY_TIMEOUT;
-  NC_WD_MODE wd = NC_WD_ALL;
-  NC_PARAMTYPE param = NC_PARAMTYPE_CONST;
-  LYS_INFORMAT ly_format = LYS_IN_YANG;
