-  *(out + delta) = *dmrs++;
-  *(out + delta + 2) = *dmrs++;
-  *(out + delta + 4) = *dmrs++;
-  *(out + delta + 6) = *dmrs++;
-  *(out + delta + 8) = *dmrs++;
-  *(out + delta + 10) = *dmrs++;
-}
-
-/*
-Data in DMRS symbol for Type 1, NumCDMGroupNoData = 1 and delta 0 (antenna port 0 and 1).
