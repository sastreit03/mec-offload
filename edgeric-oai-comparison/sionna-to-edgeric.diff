-  pWls->nTotalAllocCnt = 0;
-  pWls->nTotalFreeCnt = 0;
-  pWls->nTotalUlBufAllocCnt = 0;
-  pWls->nTotalUlBufFreeCnt = 0;
-  pWls->nTotalDlBufAllocCnt = 0;
-  pWls->nTotalDlBufFreeCnt = 0;
