+-static void nfapi_tag_vals_fn(gchar* s, guint32 v)
+-{
+-	int index = look_up_tlv(v);
+-	if (v >= 0)
+-	{
+-		g_snprintf(s, ITEM_LABEL_LENGTH, "%s (0x%x)", tags[index].name, v);
+-	}
+-	else
+-	{
+-		g_snprintf(s, ITEM_LABEL_LENGTH, "%s (0x%x)", "Unknown", v);
+-	}
+-}
