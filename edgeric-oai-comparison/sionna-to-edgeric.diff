-  if grep -q "${alias}" ~/.bash_aliases; then echo "cannot add alias ${alias}: already exists in ~/.bash_aliases"; return 1; fi
-  echo "alias ${alias}='${cmd}'" >> ~/.bash_aliases
-}
-
