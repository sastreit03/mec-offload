-static bool is_ntn_band(int band)
-{
-  // TS 3GPP 38.101-5 V1807 Section 5.2.2
-  if (band >= 254 && band <= 256) // FR1 NTN
-    return true;
-
-  // TS 3GPP 38.101-5 V1807 Section 5.2.3
-  if (band >= 510 && band <= 512) // FR2 NTN
-    return true;
-
-  return false;
-}
