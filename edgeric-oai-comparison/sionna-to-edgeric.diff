+
+  if (LOG_DEBUGFLAG(DEBUG_DLSCH_DECOD)) {
+    LOG_D(PHY,"decoder input(segment %u) :",r);
+
+    for (int i=0; i<E; i++)
+      LOG_D(PHY,"%d : %d\n",i,harq_process->d[r][i]);
