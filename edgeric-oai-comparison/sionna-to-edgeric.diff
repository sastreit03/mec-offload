+int init_test(unsigned char N_tx, unsigned char N_rx, unsigned char transmission_mode,
+              unsigned char extended_prefix_flag, uint8_t frame_type, uint16_t Nid_cell, int N_RB_DL) {
+  (void) transmission_mode;
