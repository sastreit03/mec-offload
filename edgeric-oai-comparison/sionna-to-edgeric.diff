-    rte_eal_remote_launch(pmd_lcore_ldpc_enc, &t_params[used_cores++], lcore_id);
-  }
-  rte_atomic16_set(&op_params->sync, SYNC_START);
-  ret = pmd_lcore_ldpc_enc(&t_params[0]);
-  rte_free(t_params);
-  return ret;
