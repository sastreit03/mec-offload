-  unsigned long* va = WLS_PA2VA(pWls->hWls, pa);
-  AssertFatal(va, "WLS_PA2VA failed for headerElem\n");
-  while (*va != -1) {
-    pa = WLS_DequeueBlock(pWls->hWls);
-    AssertFatal(pa, "WLS_DequeueBlock failed for pa_hdr\n");
-    va = WLS_PA2VA(pWls->hWls, pa);
-  }
-  return pa;
