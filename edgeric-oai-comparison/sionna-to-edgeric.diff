-int decode_fgc_nas_message_container(FGCNasMessageContainer *nasmessagecontainer, uint8_t iei, uint8_t *buffer, uint32_t len)
-{
-  int decoded = 0;
-  uint8_t ielen = 0;
-  int decode_result;
-
-  if (iei > 0) {
-    CHECK_IEI_DECODER(iei, *buffer);
-    decoded++;
