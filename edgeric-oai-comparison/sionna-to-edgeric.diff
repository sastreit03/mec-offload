+/**********************************************************************
+*
+* FILENAME    :  pss_test.c
+*
+* MODULE      :  UE test bench for synchronisation
+*
+* DESCRIPTION :  it allows unitary tests of UE synchronisation on host machine
+*
+************************************************************************/
+
+#include <stdlib.h>
