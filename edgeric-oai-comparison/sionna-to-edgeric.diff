-static F1AP_F1AP_PDU_t *f1ap_encode_decode(const F1AP_F1AP_PDU_t *enc_pdu)
-{
-  //xer_fprint(stdout, &asn_DEF_F1AP_F1AP_PDU, enc_pdu);
