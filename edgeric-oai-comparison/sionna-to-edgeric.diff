-    shm_td_iq_channel_produce_samples(channel, num_samples_per_update);
-    usleep(20000);
-  }
-  return 0;
-}
-
-void server(void)
-{
-  int num_ant_tx = 1;
-  int num_ant_rx = 1;
-  ShmTDIQChannel *channel = shm_td_iq_channel_create(SHM_CHANNEL_NAME, num_ant_tx, num_ant_rx);
-
-  pthread_t producer_thread;
