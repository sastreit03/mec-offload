-          if (pduIE->dRB_Failed_List_NG_RAN) {
-            pduModified->numDRBFailed = pduIE->dRB_Failed_List_NG_RAN->list.count;
-            for (int j = 0; j < pduIE->dRB_Failed_List_NG_RAN->list.count; j++) {
