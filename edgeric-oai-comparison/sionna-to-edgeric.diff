-  // UE DL Aggregate Maximum Bit Rate (O)
-  if (in->ueDlAggMaxBitRate) {
-    asn1cSequenceAdd(out->protocolIEs.list, E1AP_BearerContextModificationRequestIEs_t, ie4);
-    ie4->id = E1AP_ProtocolIE_ID_id_UEDLAggregateMaximumBitRate;
