-    break;
-    case NFAPI_NR_PHY_MSG_TYPE_UL_DCI_REQUEST:
-      if (check_nr_fapi_unpack_length(NFAPI_NR_PHY_MSG_TYPE_UL_DCI_REQUEST, unpackedBufLen))
-        result = unpack_ul_dci_request(&pReadPackedMessage, end, pMessageHeader, config);
