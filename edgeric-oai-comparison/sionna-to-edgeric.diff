-    const uint32_t byte_len = (value->TLVs[i].length + 3) / 4;
-    switch (value->TLVs[i].tag) {
-      case 0: {
-        if (!pusharray32(value->TLVs[i].value.direct, byte_len, byte_len, ppWritePackedMsg, end)) {
