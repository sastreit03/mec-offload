+/*! \file nr_polar_init.c
+ * \brief
+ * \author Turker Yilmaz, Raymond Knopp
+ * \date 2018
+ * \version 0.1
+ * \company EURECOM
+ * \email turker.yilmaz@eurecom.fr, raymond.knopp@eurecom.fr
