-    NFAPI_TRACE(NFAPI_TRACE_INFO, "\nTotalBlocks is %d \n", pWls->nTotalBlocks);
-int nBlocks = 0;
-for(int i = 0 ; i< pWls->nTotalBlocks; i++){
-  void* pMsg =  wls_mac_alloc_buffer(pWls, 0, i);
-   /* Enqueue all blocks */
-  nBlocks += WLS_EnqueueBlock(pWls->hWls, WLS_VA2PA(pWls->hWls, pMsg));
